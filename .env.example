# ---- Keyword enrichment (pick ONE provider) ----
# keywordseverywhere | dataforseo | none
KEYWORD_PROVIDER=keywordseverywhere
KEYWORDS_EVERYWHERE_API_KEY=
# DataForSEO (trial gives free credit): use your API login + password from the dashboard
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
KEYWORD_COUNTRY=us          # KE country code / DFS mapped below (us, gb, in ...)

# ---- Alerts (either or both; users can also paste a webhook in the UI) ----
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# ---- Crawler behaviour ----
RESPECT_ROBOTS=true
MAX_POSTS_PER_RUN=60        # max new article pages fetched per run
ENRICH_MAX=25               # max keyword lookups per run (saves API credits)
REQUEST_TIMEOUT=15
# USER_AGENT=Mozilla/5.0 (compatible; CompetitorWatch/1.0)

# ---- App ----
DB_PATH=data/watch.db
CHECK_INTERVAL_HOURS=0      # >0 = re-check all watched domains automatically
MAX_DOMAINS=25
ALLOW_PRIVATE=0             # keep 0 on a public host (SSRF protection)
